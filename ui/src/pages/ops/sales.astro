---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import ModeLabel from "../../components/ModeLabel.astro";
import { getLang } from "../../data/attendee";
import { t } from "../../i18n";
import en from "../../i18n/features/sales.en.json";
import ja from "../../i18n/features/sales.ja.json";

const lang = getLang(Astro.cookies);
const strings = (lang === "ja" ? ja : en).sales;
---

<Base title={`${t(lang, "sales.title")} (MiceMax)`}>
  <Header />
  <main class="mx-auto w-full min-w-0 max-w-5xl px-6 py-8" id="sales" data-lang={lang} data-strings={JSON.stringify(strings)}>
    <a href="/nav" class="text-sm text-ink-soft hover:underline">← MiceMax</a>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "sales.title")}</h1>
      <ModeLabel lang={lang} mode="live" />
    </div>
    <p class="mt-2 max-w-[75ch] text-sm text-ink-soft">{t(lang, "sales.intro")}</p>

    <section class="mt-6 rounded-xl bg-ink px-5 py-4 text-paper">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="flex items-center gap-2 text-sm font-semibold">
            <i class="ph ph-robot text-base text-banana" aria-hidden="true"></i>
            <span id="sales-status">{t(lang, "sales.loading")}</span>
          </h2>
          <p id="sales-progress" class="mt-1 font-mono text-xs tabular-nums text-paper/60"></p>
        </div>
        <button id="sales-run" type="button" disabled
          class="min-h-11 rounded-lg bg-banana px-4 text-sm font-semibold text-paper hover:bg-banana/90 disabled:opacity-50">
          {t(lang, "sales.run")}
        </button>
      </div>
      <ol id="sales-queue" class="mt-3 space-y-1 text-sm empty:hidden"></ol>
    </section>

    <p class="mt-6 text-xs text-ink-soft">{t(lang, "sales.scoreNote")}</p>
    <div class="mt-2 overflow-x-auto rounded-xl border border-ink/10 bg-paper">
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="bg-muted text-xs text-ink-soft">
          <tr>
            <th class="px-3 py-2 font-medium">{t(lang, "sales.colScore")}</th>
            <th class="px-3 py-2 font-medium">{t(lang, "sales.colConference")}</th>
            <th class="px-3 py-2 font-medium">{t(lang, "sales.colDates")}</th>
            <th class="px-3 py-2 text-right font-medium">{t(lang, "sales.colSize")}</th>
            <th class="px-3 py-2 font-medium">{t(lang, "sales.colReasons")}</th>
            <th class="px-3 py-2"><span class="sr-only">{t(lang, "sales.draftOne")}</span></th>
          </tr>
        </thead>
        <tbody id="sales-rows"></tbody>
      </table>
    </div>
    <template id="sales-live"><ModeLabel lang={lang} mode="live" /></template>
  </main>
</Base>

<script>
  import { initSales } from "../../scripts/sales-agent";
  initSales();
</script>
