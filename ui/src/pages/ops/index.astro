---
/** /ops: the company showcase. A 3D agent network hero (scripts/ops-hero),
 * real counts, one conference end to end, then links to the live screens. */
export const prerender = false;

import Base from "../../layouts/Base.astro";
import RoleSelector from "../../components/RoleSelector.astro";
import Hero from "../../components/ops-home/Hero.astro";
import Timeline from "../../components/ops-home/Timeline.astro";
import TryLive from "../../components/ops-home/TryLive.astro";
import { getLang } from "../../data/attendee";
import { randomPhoto, creditKey } from "../../data/photos";
import { t } from "../../i18n";

const lang = getLang(Astro.cookies);
const photoSlug = randomPhoto();
---

<Base title={`${t(lang, "opsHome.title")} (MiceMax)`}>
  <RoleSelector lang={lang} active="ops" title={t(lang, "opsHome.headerTitle")} photoSlug={photoSlug} />
  <div class="oh-page bg-[#05070d] text-slate-100">
    <main>
      <Hero lang={lang} />
      <Timeline lang={lang} />
      <TryLive lang={lang} />
    </main>
    <footer class="pb-4">
      <p class="mx-auto max-w-7xl px-6 text-right text-[11px] text-slate-500">
        {t(lang, creditKey(photoSlug))} {t(lang, "login.photoCreditSuffix")}
      </p>
    </footer>
  </div>
</Base>

<script>
  import "../../scripts/ops-hero";
  import "../../scripts/ops-home-scroll";
</script>

<style is:global>
  .oh-page { color-scheme: dark; }
  .oh-glass {
    border: 1px solid rgb(255 255 255 / 0.08);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 20px 50px -30px rgb(0 0 0 / 0.8);
  }
  .oh-vignette {
    background:
      linear-gradient(90deg, rgb(5 7 13 / 0.85) 0%, rgb(5 7 13 / 0.35) 45%, transparent 70%),
      linear-gradient(0deg, #05070d 0%, rgb(5 7 13 / 0.6) 22%, transparent 45%);
  }
  .oh-card { transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s; }
  .oh-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    box-shadow: 0 30px 60px -30px color-mix(in srgb, var(--c) 50%, transparent);
  }

  /* Timeline: the line fills with scroll (--p from 0 to 1), beats fade in. */
  .oh-line-fill {
    transform: scaleY(var(--p, 0));
    background: linear-gradient(180deg, #38bdf8, #a78bfa 55%, #f472b6);
    box-shadow: 0 0 12px 1px rgb(56 189 248 / 0.6);
  }
  .oh-node {
    background: #05070d;
    border: 2px solid var(--c);
    box-shadow: 0 0 0 4px #05070d;
    transition: background-color 0.5s, box-shadow 0.5s;
  }
  .oh-beat.is-in .oh-node {
    background: var(--c);
    box-shadow: 0 0 0 4px #05070d, 0 0 18px 3px color-mix(in srgb, var(--c) 70%, transparent);
  }
  .oh-ready .oh-beat { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease-out, transform 0.7s ease-out; }
  .oh-ready .oh-beat.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .oh-ready .oh-beat { opacity: 1; transform: none; transition: none; }
    .oh-card, .oh-card:hover { transform: none; }
  }
</style>
