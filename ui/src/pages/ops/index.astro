---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import { opsConferenceIds, conferenceById } from "../../data";
import { getLang } from "../../data/attendee";
import { t } from "../../i18n";

const lang = getLang(Astro.cookies);
const confs = opsConferenceIds()
  .map((id) => conferenceById(id))
  .filter((c) => c !== undefined);
---

<Base title={`${t(lang, "ops.title")} (MiceMax)`}>
  <Header />
  <main class="mx-auto w-full min-w-0 max-w-5xl overflow-x-clip px-6 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "ops.title")}</h1>
    <p class="mt-2 max-w-[75ch] text-sm text-ink-soft">{t(lang, "ops.intro")}</p>
    <section class="mt-6 flex flex-col gap-3">
      {confs.map((c) => (
        <a
          href={`/ops/${c.id}`}
          class="group flex flex-wrap items-baseline justify-between gap-3 rounded-lg border border-ink/10 px-4 py-3 transition-colors hover:border-ink/25"
        >
          <span>
            <span class="block font-medium">{(lang === "ja" && c.name_ja) || c.name_en}</span>
            <span class="font-mono text-xs tabular-nums text-ink-soft">{c.start_date} – {c.end_date}</span>
          </span>
          <i class="ph ph-arrow-right text-ink-soft transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
        </a>
      ))}
    </section>
  </main>
</Base>
