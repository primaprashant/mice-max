---
export const prerender = false;

import Base from "../layouts/Base.astro";
import RoleSelector from "../components/RoleSelector.astro";
import SimulatedLabel from "../components/SimulatedLabel.astro";
import { randomPhoto, creditKey } from "../data/photos";
import {
  cityEstimates,
  demoConferenceIds,
  committedSpend,
  committedSpendDetailed,
  simulationScales,
  reachByConference,
} from "../data";
import { spendByKind, spendByArea, totalsOf } from "../data/city-view";
import { getLang } from "../data/attendee";
import { yen, monthLabel } from "../data/city";
import { t } from "../i18n";

const lang = getLang(Astro.cookies);
const photoSlug = randomPhoto();
const estimates = cityEstimates();
const totals = totalsOf(estimates);
const scales = simulationScales();
const reach = reachByConference();
const demoIds = demoConferenceIds();

// Committed spend from the simulated log, scaled up to real conference sizes.
const reachedTotal = demoIds.reduce((s, id) => {
  const r = reach.get(id);
  if (!r || r.total === 0) return s;
  return s + Math.round(r.reached * ((scales.get(id) ?? 1) * r.total) / r.total);
}, 0);
const scaledTotals = (() => {
  let count = 0;
  let jpy = 0;
  for (const id of demoIds) {
    const scale = scales.get(id) ?? 1;
    const rows = committedSpend(id);
    count += rows.length * scale;
    jpy += rows.reduce((s, r) => s + (r.jpy ?? 0), 0) * scale;
  }
  return { count: Math.round(count), jpy: Math.round(jpy) };
})();

const byKind = spendByKind(
  demoIds.flatMap((id) => {
    // Count scaled by repeating each row proportionally is overkill for the
    // demo; show the raw log counts with the scaled money.
    return committedSpend(id);
  })
);
const byArea = spendByArea(demoIds.flatMap((id) => committedSpend(id))).map((a) => {
  // experiences.area_id is NULL for plans booked at the venue itself; the
  // data layer falls back to "Other" — give the bucket its real name.
  const unknown = !a.area || a.area === "Other";
  return {
    ...a,
    area: unknown ? t(lang, "city.areaUnknown") : a.area,
    area_ja: unknown ? t(lang, "city.areaUnknown") : a.area_ja,
  };
});

// Area donut: top six areas, rest folded into Other. Slots come from the
// validated chart palette (see global.css), Other takes the muted gray.
const DONUT_SLOTS = ["var(--color-banana)", "var(--color-viz-blue)", "var(--color-viz-green)", "var(--color-viz-violet)", "var(--color-viz-aqua)", "var(--color-viz-red)", "var(--color-muted-strong)"];
const donutSlices = [
  ...byArea.slice(0, 6).map((a, i) => ({
    key: a.area,
    name: lang === "ja" ? a.area_ja : a.area,
    jpy: a.jpy,
    count: a.count,
    color: DONUT_SLOTS[i],
  })),
  {
    key: "__other__",
    name: t(lang, "city.other"),
    jpy: byArea.slice(6).reduce((s, a) => s + a.jpy, 0),
    count: byArea.slice(6).reduce((s, a) => s + a.count, 0),
    color: DONUT_SLOTS[6],
  },
];
const donutTotal = donutSlices.reduce((s, x) => s + x.jpy, 0);

const formula = t(lang, "city.formula");

// Monthly committed spend for the over-time chart and its table view. Same
// committed rows as the splits, at the raw simulated-log amounts (the scaled
// numbers live in the stat tiles above).
const monthly = committedSpendDetailed();
const monthlyTotals = new Map<string, { count: number; jpy: number }>();
for (const r of monthly) {
  const cur = monthlyTotals.get(r.month) ?? { count: 0, jpy: 0 };
  cur.count += r.count;
  cur.jpy += r.jpy;
  monthlyTotals.set(r.month, cur);
}
const monthlyTotalsArr = [...monthlyTotals.entries()]
  .map(([month, v]) => ({ month, ...v }))
  .sort((a, j) => a.month.localeCompare(j.month));
/** Compact yen for chart labels: ¥2.5M, ¥636K. */
function yenCompact(n: number): string {
  return n >= 1000000 ? `¥${(n / 1000000).toFixed(1)}M` : `¥${Math.round(n / 1000)}K`;
}
// Per-month detail for the selectable bar: breakdown by spend type and by
// conference, embedded as JSON for the client script.
const monthlyDetail: Record<string, { kind: { kind: string; count: number; jpy: number }[]; conference: { name: string; jpy: number }[] }> = {};
for (const m of monthlyTotalsArr) {
  const rows = monthly.filter((r) => r.month === m.month);
  const kinds = new Map<string, { kind: string; count: number; jpy: number }>();
  const confs = new Map<string, number>();
  for (const r of rows) {
    const k = kinds.get(r.kind) ?? { kind: r.kind, count: 0, jpy: 0 };
    k.count += r.count;
    k.jpy += r.jpy;
    kinds.set(r.kind, k);
    confs.set(r.conference, (confs.get(r.conference) ?? 0) + r.jpy);
  }
  monthlyDetail[m.month] = {
    kind: [...kinds.values()].sort((a, b) => b.jpy - a.jpy),
    conference: [...confs.entries()]
      .map(([name, jpy]) => ({ name, jpy }))
      .sort((a, b) => b.jpy - a.jpy),
  };
}
---

<Base title={`${t(lang, "city.title")} (MiceMax)`}>
  <RoleSelector lang={lang} active="city" title={t(lang, "city.title")} photoSlug={photoSlug} />
  <main class="mx-auto max-w-7xl px-6 py-8">
    <p class="max-w-[75ch] text-sm text-ink-soft">{t(lang, "city.intro")}</p>

    <section class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-ink/10 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-soft">{t(lang, "city.reached")}</p>
        <p class="mt-2 font-mono text-3xl font-semibold tabular-nums">{reachedTotal.toLocaleString("ja-JP")}</p>
      </div>
      <div class="rounded-xl border border-ink/10 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-soft">{t(lang, "city.booked")}</p>
        <p class="mt-2 font-mono text-3xl font-semibold tabular-nums">{scaledTotals.count.toLocaleString("ja-JP")}</p>
        <p class="mt-1 text-xs text-ink-soft">{t(lang, "city.bookedNote")}</p>
      </div>
      <div class="rounded-xl border border-ink/10 p-5">
        <p class="text-xs uppercase tracking-wide text-ink-soft">{t(lang, "city.newSpend")}</p>
        <p class="mt-2 font-mono text-3xl font-semibold tabular-nums">{yen(scaledTotals.jpy)}</p>
        <p class="mt-1 text-xs text-ink-soft">{t(lang, "city.newSpendNote")}</p>
      </div>
    </section>

    <section class="mt-10">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "city.byKind")}</h2>
        <div class="mt-3 space-y-3">
          {byKind.map((k) => (
            <div class="flex items-center gap-3">
              <span class="w-32 shrink-0 text-sm">{t(lang, `experienceKind.${k.kind}`)}</span>
              <div class="h-4 min-w-[2px] shrink rounded-r-[4px] bg-banana" style={`width:${(k.jpy / byKind[0].jpy) * 100}%`} />
              <span class="whitespace-nowrap font-mono text-sm tabular-nums">{yen(k.jpy)}</span>
              <span class="font-mono text-xs tabular-nums text-ink-soft">{k.count}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "city.byArea")}</h2>
        <city-area-donut class="mt-3 block">
          <div class="mx-auto flex w-[80%] flex-wrap items-center justify-center gap-16" slot="donut">
            <div class="relative min-w-0 flex-1 basis-[420px]" style="max-width:528px">
              <svg viewBox="0 0 120 120" class="block h-auto w-full" role="img" aria-label={t(lang, "city.byArea")}>
                {(() => {
                  const R = 48;
                  const C = 2 * Math.PI * R;
                  let acc = 0;
                  return donutSlices.map((s) => {
                    const frac = s.jpy / donutTotal;
                    const el = (
                      <g
                        data-area={s.key}
                        data-name={s.name}
                        data-jpy={s.jpy}
                        data-count={s.count}
                        role="img"
                        aria-label={`${s.name}: ${yen(s.jpy)}`}
                      >
                        <circle
                          cx="60" cy="60" r={R} fill="none"
                          stroke={s.color}
                          stroke-width="20"
                          stroke-dasharray={`${Math.max(frac * C - 1.5, 0.5)} ${C}`}
                          stroke-dashoffset={-acc * C}
                          transform="rotate(-90 60 60)"
                        />
                      </g>
                    );
                    acc += frac;
                    return el;
                  });
                })()}
              </svg>
              <!-- center readout: total until a slice is selected -->
              <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center">
                <p class="max-w-[160px] text-xs leading-tight text-ink-soft" id="city-donut-label">{t(lang, "city.donutTotal")}</p>
                <p class="font-mono text-2xl font-semibold" id="city-donut-value">{yen(donutTotal)}</p>
                <p class="max-w-[160px] text-xs leading-tight text-ink-soft" id="city-donut-sub"></p>
              </div>
            </div>
            <div class="min-w-[280px] flex-1 space-y-1.5">
              {donutSlices.map((s) => (
                <p
                  class="flex items-center gap-2 rounded text-sm hover:bg-ink/5"
                  data-area={s.key}
                  data-legend=""
                >
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background:${s.color}`} />
                  <span class="text-left">{s.name}</span>
                  <span class="font-mono text-ink-soft tabular-nums">{Math.round((s.jpy / donutTotal) * 100)}%</span>
                  <span class="font-mono tabular-nums">{yen(s.jpy)}</span>
                </p>
              ))}
              <p class="pt-1 text-xs text-ink-soft">{donutSlices[donutSlices.length - 1].count} {t(lang, "city.count")}</p>
            </div>
          </div>
        </city-area-donut>
      </div>
    </section>

    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "city.overTime")}</h2>
          <p class="mt-1 text-xs text-ink-soft">{t(lang, "city.overTimeNote")}</p>
        </div>
        <div class="flex items-center gap-3">
          <SimulatedLabel lang={lang} />
          <button
            type="button"
            id="city-chart-toggle"
            class="inline-flex min-h-[44px] items-center rounded-lg border border-ink/15 px-4 py-2 text-sm font-medium hover:bg-ink/5"
            data-label-table={t(lang, "city.chartTable")}
            data-label-chart={t(lang, "city.chartTableClose")}
          >{t(lang, "city.chartTable")}</button>
          <a
            href="/api/city-spend.csv"
            class="inline-flex min-h-[44px] items-center rounded-lg bg-theme px-4 py-2 text-sm font-medium text-white hover:bg-theme-strong"
            download="micemax-city-spend.csv"
          >{t(lang, "city.exportCsv")}</a>
        </div>
      </div>
      <city-spend-chart class="mt-3 block">
        <div class="relative mx-auto w-[80%]" slot="chart">
          <svg
            viewBox="0 0 640 240"
            class="block h-auto w-full"
            role="img"
            aria-label={t(lang, "city.overTime")}
          >
            <!-- hairline gridlines at clean ticks; recessive -->
            <g class="grid" stroke="currentColor" stroke-width="1" opacity="0.08">
              {Array.from({ length: 4 }, (_, i) => {
                const y = 200 - (i + 1) * 40;
                return <line x1="48" x2="632" y1={y} y2={y} />;
              })}
            </g>
            <!-- y-axis tick labels: compact yen, clean numbers, zero at baseline -->
            <g class="ticks text-ink-soft" fill="currentColor" font-size="11" font-family="Geist Mono, monospace">
              <text x="42" y="204" text-anchor="end">¥0</text>
              {Array.from({ length: 4 }, (_, i) => {
                const v = (4 - i) * 250000;
                return (
                  <text x="42" y={204 - (4 - i) * 40} text-anchor="end">
                    {v >= 1000000 ? `¥${v / 1000000}M` : `¥${v / 1000}K`}
                  </text>
                );
              })}
            </g>
            <!-- bars: 24px thin marks, 4px rounded data-end, square baseline;
                 scale 40px per ¥250K so ticks and bars agree. Banana: the token
                 that marks MiceMax events in every data view. -->
            <g class="bars" fill="var(--color-banana)">
              {monthlyTotalsArr.map((m, i) => {
                const h = Math.max(2, Math.round((m.jpy / 250000) * 40));
                const x = 72 + i * 112 + 20;
                const y = 200 - h;
                const d = h > 4
                  ? `M${x} 200 V${y + 4} Q${x} ${y} ${x + 4} ${y} H${x + 20} Q${x + 24} ${y} ${x + 24} ${y + 4} V200 Z`
                  : `M${x} 200 h24 v-${h} h-24 Z`;
                return (
                  <g class="bar-group" data-month={m.month} data-count={m.count} data-jpy={m.jpy}>
                    <path d={d} class="bar cursor-pointer" />
                    {/* keyboard focus ring: SVG ignores CSS outline, so the
                        ring is a stroke around the bar shown on focus */}
                    <path
                      d={d}
                      class="pointer-events-none absolute bar-ring"
                      fill="none"
                      stroke="var(--color-theme)"
                      stroke-width="2"
                      opacity="0"
                    />
                  </g>
                );
              })}
            </g>
            <!-- direct labels: every bar carries its price -->
            <g class="labels text-ink" fill="currentColor" font-size="12" font-family="Geist Mono, monospace">
              {monthlyTotalsArr.map((m, i) => {
                const h = Math.max(2, Math.round((m.jpy / 250000) * 40));
                const x = 72 + i * 112 + 32;
                const y = 200 - h - 6;
                return <text x={x} y={y} text-anchor="middle">{yenCompact(m.jpy)}</text>;
              })}
            </g>
            <!-- x-axis month labels with the year -->
            <g class="x-labels text-ink-soft" fill="currentColor" font-size="11" font-family="Geist Mono, monospace">
              {monthlyTotalsArr.map((m, i) => (
                <text x={72 + i * 112 + 32} y="222" text-anchor="middle">
                  {monthLabel(m.month, lang)}
                </text>
              ))}
            </g>
            <!-- baseline -->
            <line x1="48" x2="632" y1="200" y2="200" class="text-ink" stroke="currentColor" opacity="0.2" />
          </svg>
          <!-- tooltip, positioned by the client script -->
          <div
            id="city-chart-tooltip"
            class="pointer-events-none absolute z-10 hidden rounded-lg border border-ink/10 bg-paper px-3 py-2 text-xs shadow-sm"
          >
            <p class="font-mono font-semibold tabular-nums" id="city-chart-tooltip-value"></p>
            <p class="text-ink-soft" id="city-chart-tooltip-detail"></p>
          </div>
          <script
            type="application/json"
            data-monthly-detail
            set:html={JSON.stringify(monthlyDetail)}
          />
        </div>
        <table class="mx-auto w-[80%] text-sm" slot="table" hidden>
          <caption class="sr-only">{t(lang, "city.overTime")}</caption>
          <thead>
            <tr class="border-b border-ink/10 text-left text-xs text-ink-soft">
              <th scope="col" class="px-3 py-2 font-medium">{t(lang, "city.month")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.count")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.spend")}</th>
            </tr>
          </thead>
          <tbody>
            {/* one row per month: the aggregated totals the bars plot, not the
                per-area detail rows the frontmatter keeps for the panel */}
            {monthlyTotalsArr.map((m) => (
              <tr class="border-b border-ink/5">
                <td class="px-3 py-2 font-mono tabular-nums">{monthLabel(m.month, lang)}</td>
                <td class="px-3 py-2 text-right font-mono tabular-nums">{m.count.toLocaleString("ja-JP")}</td>
                <td class="px-3 py-2 text-right font-mono tabular-nums">{yen(m.jpy)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <!-- month breakdown panel: updated when a bar is selected; tinted with
             the same theme accent that marks the selected bar -->
        <div id="city-month-detail" class="mx-auto mt-4 w-[80%] rounded-xl border border-theme/25 bg-theme-soft/60 p-5">
          <p class="text-xs uppercase tracking-wide text-theme-strong" id="city-month-detail-title"></p>
          <p class="mt-1 font-mono text-2xl font-semibold" id="city-month-detail-total"></p>
          <p class="mt-1 text-xs text-ink-soft" id="city-month-detail-count"></p>
          <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft" id="city-detail-kinds-title"></p>
              <dl id="city-detail-kinds" class="mt-2 space-y-1.5"></dl>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft" id="city-detail-confs-title"></p>
              <dl id="city-detail-confs" class="mt-2 space-y-1.5"></dl>
            </div>
          </div>
        </div>
      </city-spend-chart>
    </section>

    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "city.next12Months")}</h2>
      <p class="mt-1 max-w-[75ch] text-xs text-ink-soft">{t(lang, "city.uptakeNote")}</p>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full min-w-[720px] text-sm">
          <caption class="sr-only">{t(lang, "city.next12Months")}</caption>
          <thead>
            <tr class="border-b border-ink/10 text-left text-xs text-ink-soft">
              <th scope="col" class="px-3 py-2 font-medium">{t(lang, "city.conference")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.attendees")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.early")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.middle")}</th>
              <th scope="col" class="px-3 py-2 text-right font-medium">{t(lang, "city.strong")}</th>
            </tr>
          </thead>
          <tbody>
            {estimates.map((e) => (
              <tr class="border-b border-ink/5">
                <td class="px-3 py-2">
                  <span class="block max-w-[40ch] truncate font-medium">{e.name_en}</span>
                  {e.start_date && <span class="font-mono text-[11px] tabular-nums text-ink-soft">{e.start_date}</span>}
                </td>
                <td class="px-3 py-2 text-right font-mono tabular-nums">{e.attendees.toLocaleString("ja-JP")}</td>
                <td class="px-3 py-2 text-right font-mono tabular-nums text-ink-soft">{yen(e.early_jpy)}</td>
                <td class="px-3 py-2 text-right font-mono tabular-nums">{yen(e.middle_jpy)}</td>
                <td class="px-3 py-2 text-right font-mono tabular-nums text-ink-soft">{yen(e.strong_jpy)}</td>
              </tr>
            ))}
            <tr class="font-semibold">
              <td class="px-3 py-2">{t(lang, "city.total")}</td>
              <td class="px-3 py-2 text-right font-mono tabular-nums">{estimates.reduce((s, e) => s + e.attendees, 0).toLocaleString("ja-JP")}</td>
              <td class="px-3 py-2 text-right font-mono tabular-nums">{yen(totals.early)}</td>
              <td class="px-3 py-2 text-right font-mono tabular-nums">{yen(totals.middle)}</td>
              <td class="px-3 py-2 text-right font-mono tabular-nums">{yen(totals.strong)}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 rounded-xl border border-ink/10 p-5">
      <h2 class="text-sm font-semibold">{t(lang, "city.formulaTitle")}</h2>
      <p class="mt-2 max-w-[80ch] font-mono text-xs leading-relaxed">{formula}</p>
    </section>

    <script>
      import "../scripts/city-spend-chart";
      import "../scripts/city-area-donut";
    </script>
  </main>
  <footer class="pb-4">
    <p class="mx-auto max-w-7xl px-6 text-right text-[11px] text-ink-soft">
      {t(lang, creditKey(photoSlug))} {t(lang, "login.photoCreditSuffix")}
    </p>
  </footer>
</Base>
