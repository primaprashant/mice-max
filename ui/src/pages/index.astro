---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { conferences, experiencesForConference, experienceCopy } from "../data";
import { t, type Lang } from "../i18n";

const lang: Lang = Astro.cookies.get("lang")?.value === "ja" ? "ja" : "en";
const demoConfs = conferences();

const routes = [
  { path: "/login", label: t(lang, "nav.login"), note: t(lang, "nav.loginNote") },
  ...demoConfs.map((c) => ({
    path: `/c/${c.id}`,
    label: (lang === "ja" && c.name_ja) || c.name_en,
    note: t(lang, "nav.calendarNote"),
    experiences: experiencesForConference(c.id).slice(0, 3).map((e) => ({
      path: `/c/${c.id}/e/${e.id}`,
      label: experienceCopy(e.id, lang)?.card_title ?? e.id,
    })),
  })),
];
---

<Base title={t(lang, "app.name")}>
  <Header />
  <main class="mx-auto max-w-xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "app.name")}</h1>
    <p class="mt-2 max-w-[65ch] text-sm text-ink-soft">{t(lang, "nav.intro")}</p>

    <ul class="mt-8 flex flex-col gap-3">
      {routes.map((r) => (
        <li>
          <a href={r.path} class="block rounded-lg border border-ink/10 bg-paper px-4 py-3 transition-transform active:scale-[0.99]">
            <span class="block text-sm font-medium">{r.label}</span>
            <span class="mt-0.5 block text-xs text-ink-soft">{r.note}</span>
          </a>
          {"experiences" in r && (
            <ul class="mt-2 flex flex-col gap-1 pl-4">
              {r.experiences.map((e) => (
                <li>
                  <a href={e.path} class="block rounded border-l-2 border-ink/15 pl-3 py-1 text-xs text-ink-soft hover:text-ink">
                    {e.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </main>
</Base>
