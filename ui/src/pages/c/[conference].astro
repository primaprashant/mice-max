---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import PlanCard from "../../components/PlanCard.astro";
import WindowRow from "../../components/WindowRow.astro";
import {
  conferenceById,
  sessionsForConference,
  windowsForConference,
  experiencesForConference,
  experienceById,
  experienceCopy,
  experiencePhotos,
  experienceTravel,
  windowStats,
  headlines,
  attendeeById,
  seasonFor,
  cityEventsBetween,
} from "../../data";
import { fitsWindow } from "../../data/fit";
import { getLang, ATTENDEE_COOKIE, DEMO_ATTENDEE_ID } from "../../data/attendee";
import { sunsetSapporo } from "../../data/city";
import { t } from "../../i18n";

const { conference } = Astro.params;
const conf = conferenceById(conference ?? "");
if (!conf) return Astro.redirect("/");

const lang = getLang(Astro.cookies);
const attendeeId = Astro.cookies.get(ATTENDEE_COOKIE)?.value ?? DEMO_ATTENDEE_ID;
const attendee = attendeeById(attendeeId);

const sessions = sessionsForConference(conf.id);
const windows = windowsForConference(conf.id);
const confName = (lang === "ja" && conf.name_ja) || conf.name_en;

// ISO dates parsed UTC-safe: T00:00:00 in local time shifts the day otherwise.
const days: string[] = [];
for (let t = Date.parse(conf.start_date + "T00:00:00Z"); t <= Date.parse(conf.end_date + "T00:00:00Z"); t += 86400000) {
  days.push(new Date(t).toISOString().slice(0, 10));
}

// Sessions grouped per day, sorted.
const sessionsByDay = new Map<string, typeof sessions>();
for (const s of sessions) {
  if (!sessionsByDay.has(s.day)) sessionsByDay.set(s.day, []);
  sessionsByDay.get(s.day)!.push(s);
}

// Suggestions per window: headlines first, then by shown count, all filtered
// by the shared fits rule. Cap at 4 per window like the simulator's SHOW_N.
const exps = experiencesForConference(conf.id);
const stats = windowStats(conf.id);
const hs = headlines(conf.id);
const headlineByWindow = new Map<string, string>();
for (const h of hs) headlineByWindow.set(h.window_id, h.experience_id);

type Suggestion = {
  experience: NonNullable<ReturnType<typeof experienceById>>;
  copy: NonNullable<ReturnType<typeof experienceCopy>>;
  travel?: ReturnType<typeof experienceTravel>;
};

const suggestionsByWindow = new Map<string, Suggestion[]>();

for (const w of windows) {
  const fits = exps
    .filter((e) => e.kind !== "extra_night")
    .map((e) => ({ e, travel: experienceTravel(e.id, conf.main_venue_place_id) }))
    .filter(({ e, travel }) => fitsWindow(e, w, travel?.minutes, conf))
    .sort((a, b) => (stats.get(b.e.id)?.shown ?? 0) - (stats.get(a.e.id)?.shown ?? 0))
    .slice(0, 4);
  const list: Suggestion[] = [];
  const headlineId = headlineByWindow.get(w.id);
  const ordered: { e: NonNullable<ReturnType<typeof experienceById>>; travel?: ReturnType<typeof experienceTravel> }[] = headlineId
    ? [{ e: experienceById(headlineId)!, travel: experienceTravel(headlineId, conf.main_venue_place_id) }, ...fits.filter((f) => f.e.id !== headlineId)]
    : fits;
  for (const { e, travel } of ordered) {
    const copy = experienceCopy(e.id, lang);
    if (copy) list.push({ experience: e, copy, travel });
  }
  suggestionsByWindow.set(w.id, list);
}

// Extra-night windows: their headline experiences become the banner.
const extraNightWindows = windows.filter((w) => w.kind === "extra_night");
const extraNightExperiences = extraNightWindows
  .map((w) => headlineByWindow.get(w.id))
  .filter((id): id is string => Boolean(id))
  .map((id) => experienceById(id)!)
  .filter(Boolean)
  .map((e) => ({ experience: e, copy: experienceCopy(e.id, lang)! }));

// The moment: month weather, computed sunset, what's on in the city.
const month = Number(conf.start_date.slice(5, 7));
const season = seasonFor(month);
const cityEvents = cityEventsBetween(conf.start_date, conf.end_date);
---

<Base title={`${confName} (MiceMax)`}>
  <Header />
  <main class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h1 class="max-w-[70ch] text-2xl font-semibold tracking-tight">{confName}</h1>
      {attendee && (
        <div class="flex items-center gap-2 text-sm text-ink-soft">
          <span>{lang === "ja" ? attendee.name_ja : attendee.name_en}</span>
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-theme-soft text-xs font-semibold text-theme-strong">
            {(lang === "ja" ? attendee.name_ja : attendee.name_en).slice(0, 1)}
          </span>
        </div>
      )}
    </div>

    {season && (
      <p class="mt-3 max-w-[75ch] text-sm text-ink-soft">
        {t(lang, "calendar.moment", {
          high: String(season.high_c),
          low: String(season.low_c),
          sunset: sunsetSapporo(conf.start_date),
          wear: (lang === "ja" ? season.wear_ja : season.wear_en) ?? "",
        })}
      </p>
    )}
    {cityEvents.length > 0 && (
      <p class="mt-1 max-w-[75ch] text-sm text-ink-soft">
        {t(lang, "calendar.whatsOn", {
          what: (lang === "ja" ? cityEvents.map((e) => e.name_ja) : cityEvents.map((e) => e.name_en)).join(", "),
        })}
      </p>
    )}

    {extraNightExperiences.length > 0 && (
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "calendar.extraNightBannerTitle")}</h2>
        <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
          {extraNightExperiences.map(({ experience, copy }) => (
            <a
              href={`/c/${conf.id}/e/${experience.id}`}
              class="group flex items-center gap-4 rounded-xl border border-banana bg-banana-soft p-4 transition-transform active:scale-[0.99]"
            >
              <div class="flex-1">
                <h3 class="text-base font-semibold leading-snug">{copy.card_title}</h3>
                <p class="mt-1 text-sm text-ink-soft">{copy.hook}</p>
                {experience.price_jpy != null && (
                  <p class="mt-2 font-mono text-sm font-medium tabular-nums">
                    {experience.price_jpy === 0 ? t(lang, "common.free") : t(lang, "common.priceFrom", { price: `¥${experience.price_jpy.toLocaleString("ja-JP")}` })}
                    <span class="ml-1 font-sans text-xs font-normal text-ink-soft">{t(lang, "common.allIncluded")}</span>
                  </p>
                )}
              </div>
              {(() => {
                const hero = experiencePhotos(experience.id).find((p) => p.is_hero) ?? experiencePhotos(experience.id)[0];
                return hero ? (
                  <img
                    src={hero.path}
                    alt={(lang === "ja" ? hero.alt_ja : hero.alt_en) ?? ""}
                    width={hero.width}
                    height={hero.height}
                    class="h-20 w-32 flex-shrink-0 rounded-lg object-cover"
                    style={`background-color: ${hero.dominant_color ?? "#ddd"}`}
                  />
                ) : null;
              })()}
            </a>
          ))}
        </div>
      </section>
    )}

    <first-visit-banner class="mt-6 block">
      <div class="flex items-start justify-between gap-4 rounded-xl border border-theme/30 bg-theme-soft px-4 py-3">
        <p class="max-w-[70ch] text-sm text-theme-strong">
          {(() => {
            const first = windows.find((w) => w.kind === "evening");
            return t(lang, "calendar.banner", {
              windowName: first ? (lang === "ja" ? first.name_ja : first.name_en) : "",
              n: String(suggestionsByWindow.get(first?.id ?? "")?.length ?? 0),
            });
          })()}
        </p>
        <button data-dismiss class="flex-shrink-0 text-xs text-ink-soft hover:underline">{t(lang, "common.dismiss")}</button>
      </div>
    </first-visit-banner>

    <section class="mt-10">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "common.freeTime")}</h2>
      </div>

      {days.map((day) => (
        <div class="mt-8">
          <h3 class="font-mono text-sm font-semibold tabular-nums text-ink-soft">{day}</h3>
          <div class="mt-2 flex flex-col gap-2">
            {(sessionsByDay.get(day) ?? [])
              .sort((a, b) => a.start_time.localeCompare(b.start_time))
              .map((s) => (
                <PlanCard
                  lang={lang}
                  variant="row"
                  time={{ start: s.start_time, end: s.end_time }}
                  title={(lang === "ja" ? s.title_ja : s.title_en) ?? s.id}
                />
              ))}
            {windows
              .filter((w) => w.day === day)
              .map((w) => (
                <WindowRow lang={lang} win={w} suggestions={suggestionsByWindow.get(w.id)} />
              ))}
          </div>
          <my-plans
            class="mt-2 flex flex-col gap-2"
            data-day={day}
            data-titles={JSON.stringify(
              Object.fromEntries(experiencesForConference(conf.id).map((e) => [e.id, experienceCopy(e.id, lang)?.card_title ?? e.id]))
            )}
          />
        </div>
      ))}
    </section>
  </main>
</Base>

<script>
  import "../../scripts/my-plans";
  import "../../scripts/first-visit-banner";
</script>
