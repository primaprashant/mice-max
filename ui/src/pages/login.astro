---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { getLang } from "../data/attendee";
import { t } from "../i18n";

const lang = getLang(Astro.cookies);
---

<Base title={t(lang, "app.name")}>
  <Header />
  <main class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-6 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "login.title")}</h1>
    <p class="mt-2 text-sm text-ink-soft">{t(lang, "login.conference")}</p>

    <form id="login-form" method="POST" action="/api/login" class="mt-8 flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm font-medium">{t(lang, "login.name")}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="rounded-md border border-ink/15 bg-paper px-3 py-2 text-sm focus:border-theme"
          placeholder={t(lang, "login.namePlaceholder")}
        />
      </div>
      <div class="flex flex-col gap-2">
        <label for="password" class="text-sm font-medium">{t(lang, "login.password")}</label>
        <input
          id="password"
          name="password"
          type="password"
          class="rounded-md border border-ink/15 bg-paper px-3 py-2 text-sm focus:border-theme"
        />
        <p class="text-xs text-ink-soft">{t(lang, "login.passwordHint")}</p>
      </div>

      <label class="flex items-start gap-2 text-xs leading-relaxed text-ink-soft">
        <input type="checkbox" name="consent" required class="mt-0.5 accent-theme" />
        <span>{t(lang, "login.consent")}</span>
      </label>

      <button
        type="submit"
        class="rounded-md bg-theme px-4 py-2.5 text-sm font-medium text-paper transition-transform active:scale-[0.98]"
      >
        {t(lang, "login.enter")}
      </button>
    </form>
  </main>
</Base>

<script>
  import { logEvent } from "../scripts/event-log";

  document.getElementById("login-form")?.addEventListener("submit", () => {
    logEvent("page_visited", {});
  });
</script>
