---
/** The new entry page: no login. The shared RoleSelector band on top;
 * below it, paginated conference cards that open in the role picked in
 * the band. Attendee is the default. */
export const prerender = false;

import Base from "../layouts/Base.astro";
import RoleSelector from "../components/RoleSelector.astro";
import ConferenceList from "../components/ConferenceList.astro";
import { getLang } from "../data/attendee";
import { allConferences } from "../data";
import type { Conference } from "../data/types";
import { randomPhoto, creditKey } from "../data/photos";
import { t } from "../i18n";

const lang = getLang(Astro.cookies);
const photoSlug = randomPhoto();
/* The two demo conferences always lead the list. */
const DEMO_IDS = ["jadm32", "icep2027"];

const TODAY = new Date().toISOString().slice(0, 10);

function sortKey(c: Conference): string {
  return DEMO_IDS.includes(c.id) ? "" : c.start_date;
}

const confList = allConferences()
  .filter((c) => c.start_date >= TODAY)
  .sort((a, b) => sortKey(a).localeCompare(sortKey(b)) || a.start_date.localeCompare(b.start_date));

const PER_PAGE = 10;
const totalPages = Math.ceil(confList.length / PER_PAGE);

/* The attendee tab is this page, so every card links to the attendee
   calendar; the other three tabs navigate to their own pages. */

/* Month calendar strings for the client script. */
const CAL_STRINGS = {
  monthScope: t(lang, "home.calMonthScope"),
  dayScope: t(lang, "home.calDayScope"),
};
---

<Base title={t(lang, "app.name")}>
  <RoleSelector lang={lang} active="attendee" title={t(lang, "home.title")} photoSlug={photoSlug} />

  <main class="mx-auto w-full max-w-7xl px-6 py-8">
    <div class="grid gap-8 lg:grid-cols-4">
      <div class="min-w-0 lg:col-span-3">
        <ConferenceList
          lang={lang}
          conferences={confList}
          href={(id) => `/c/${id}`}
          showDemoMark
          dateStyle="range"
          columns={1}
          data-conf-list
        />
      </div>

      <aside class="min-w-0">
        <home-calendar data-cal data-strings={JSON.stringify(CAL_STRINGS)} class="sticky top-6 block rounded-lg border border-ink/10 bg-paper p-4">
          <div class="flex items-center justify-between gap-2">
            <button type="button" data-cal-prev aria-label={t(lang, "home.calPrev")} class="rounded-md border border-ink/25 px-2 py-1.5 text-sm font-medium text-ink-soft transition-colors hover:bg-ink/5">
              <i class="ph ph-caret-left" aria-hidden="true"></i>
            </button>
            <p data-cal-label class="text-sm font-semibold tracking-tight"></p>
            <button type="button" data-cal-next aria-label={t(lang, "home.calNext")} class="rounded-md border border-ink/25 px-2 py-1.5 text-sm font-medium text-ink-soft transition-colors hover:bg-ink/5">
              <i class="ph ph-caret-right" aria-hidden="true"></i>
            </button>
          </div>
          <div data-cal-weekdays class="mt-3 grid grid-cols-7 gap-1"></div>
          <div data-cal-grid class="mt-1 grid grid-cols-7 gap-1"></div>
          <p data-cal-status class="mt-3 text-xs text-ink-soft" role="status"></p>
          <button type="button" data-cal-all class="mt-2 rounded-md border border-ink/25 px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:bg-ink/5">
            {t(lang, "home.calAllDay")}
          </button>
        </home-calendar>
      </aside>
    </div>

    <home-pagination>
    <nav data-pagination aria-label={t(lang, "home.paginationLabel")} class="mt-6 flex flex-col items-center gap-2">
      <div class="flex items-center gap-1">
        <button
          type="button"
          data-page-prev
          class="rounded-md border border-ink/25 px-3 py-1.5 text-sm font-medium text-ink-soft hover:bg-ink/5 disabled:opacity-40"
          disabled
        >
          {t(lang, "home.prevPage")}
        </button>
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
          <button
            type="button"
            data-page={p}
            aria-current={p === 1 ? "page" : "false"}
            class="min-w-8 rounded-md border border-ink/25 px-2 py-1.5 text-sm font-medium tabular-nums text-ink-soft transition-colors hover:bg-ink/5 aria-[current=page]:border-ink aria-[current=page]:bg-ink aria-[current=page]:text-paper"
          >
            {p}
          </button>
        ))}
        <button
          type="button"
          data-page-next
          class="rounded-md border border-ink/25 px-3 py-1.5 text-sm font-medium text-ink-soft hover:bg-ink/5"
        >
          {t(lang, "home.nextPage")}
        </button>
      </div>
      <p
        class="text-xs text-ink-soft"
        data-page-status
        data-range-template={t(lang, "home.showingRange")}
      >
        {t(lang, "home.showingRange", { from: "1", to: String(PER_PAGE), total: String(confList.length) })}
      </p>
    </nav>
    </home-pagination>
  </main>
  <footer class="pb-4">
    <p class="mx-auto max-w-7xl px-6 text-right text-[11px] text-ink-soft">
      {t(lang, creditKey(photoSlug))} {t(lang, "login.photoCreditSuffix")}
    </p>
  </footer>
</Base>

<script>
  import "../scripts/home-pagination";
  import "../scripts/home-calendar";
</script>
