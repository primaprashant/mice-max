---
export const prerender = false;

import Base from "../layouts/Base.astro";
import RoleSelector from "../components/RoleSelector.astro";
import { conferences } from "../data";
import { getLang } from "../data/attendee";
import { randomPhoto, creditKey } from "../data/photos";
import { t } from "../i18n";

const lang = getLang(Astro.cookies);
const confs = conferences();
const photoSlug = randomPhoto();
---

<Base title={`${t(lang, "organizer.title")} (MiceMax)`}>
  <RoleSelector lang={lang} active="organizer" title={t(lang, "organizer.title")} photoSlug={photoSlug} />
  <main class="mx-auto max-w-xl px-6 py-16">
    <p class="mt-2 max-w-[65ch] text-sm text-ink-soft">{t(lang, "organizer.intro")}</p>

    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.readProgram")}</h2>
      <form action="/ops/run" method="get" class="mt-3 flex flex-col gap-2 sm:flex-row">
        <label class="sr-only" for="program-url">{t(lang, "ingest.urlLabel")}</label>
        <input id="program-url" name="url" type="url" required placeholder="https://"
          class="min-h-11 flex-1 rounded-lg border border-ink/20 bg-paper px-4 font-mono text-sm focus:border-theme" />
        <button type="submit" class="min-h-11 rounded-lg bg-theme px-4 text-sm font-medium text-paper transition-transform active:scale-[0.98]">
          {t(lang, "ingest.run")}
        </button>
      </form>
      <p class="mt-2 text-xs text-ink-soft">{t(lang, "navLive.runNote")}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.stored")}</h2>
      <p class="mt-1 text-sm text-ink-soft">{t(lang, "organizer.storedNote")}</p>
      <ul class="mt-3 flex flex-col gap-2">
        {confs.map((c) => (
          <li>
            <a href={`/organize/${c.id}`} class="block rounded-lg border border-ink/10 px-4 py-3 transition-transform active:scale-[0.99]">
              <span class="block text-sm font-medium">{(lang === "ja" && c.name_ja) || c.name_en}</span>
              <span class="font-mono text-xs tabular-nums text-ink-soft">{c.start_date}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <footer class="pb-4">
    <p class="mx-auto max-w-7xl px-6 text-right text-[11px] text-ink-soft">
      {t(lang, creditKey(photoSlug))} {t(lang, "login.photoCreditSuffix")}
    </p>
  </footer>
</Base>
