---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { conferences } from "../data";
import { getLang } from "../data/attendee";
import { t } from "../i18n";

const lang = getLang(Astro.cookies);
const confs = conferences();
---

<Base title={`${t(lang, "organizer.title")} (MiceMax)`}>
  <Header />
  <main class="mx-auto max-w-xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "organizer.title")}</h1>
    <p class="mt-2 max-w-[65ch] text-sm text-ink-soft">{t(lang, "organizer.intro")}</p>

    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.readProgram")}</h2>
      <read-program class="block mt-3">
        <form id="upload-form" class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <label class="flex-1 rounded-lg border border-dashed border-ink/25 px-4 py-3 text-sm text-ink-soft cursor-pointer hover:border-theme">
              <input type="file" id="pdf" accept=".pdf" class="hidden" />
              <span id="pdf-name">{t(lang, "organizer.choosePdf")}</span>
            </label>
            <button type="submit" class="rounded-lg bg-theme px-4 py-2.5 text-sm font-medium text-paper transition-transform active:scale-[0.98]">
              {t(lang, "organizer.upload")}
            </button>
          </div>
        </form>
        <div id="read-progress" class="hidden mt-3 rounded-lg border border-ink/10 px-4 py-3">
          <p class="text-sm font-medium">{t(lang, "organizer.reading")}</p>
          <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-ink/10">
            <div class="h-full w-1/3 rounded-full bg-theme animate-pulse"></div>
          </div>
          <p class="mt-2 text-xs text-ink-soft">{t(lang, "organizer.readingNote")}</p>
        </div>
        <div id="read-error" class="hidden mt-3 rounded-lg border border-ink/15 bg-banana-soft px-4 py-3">
          <p class="text-sm font-medium">{t(lang, "organizer.readFailed")}</p>
          <p class="mt-1 text-xs text-ink-soft">{t(lang, "organizer.readFailedNote")}</p>
          <button id="retry" class="mt-2 rounded-md border border-ink/15 px-3 py-1.5 text-xs font-medium">{t(lang, "organizer.retry")}</button>
        </div>
      </read-program>
    </section>

    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.stored")}</h2>
      <p class="mt-1 text-sm text-ink-soft">{t(lang, "organizer.storedNote")}</p>
      <ul class="mt-3 flex flex-col gap-2">
        {confs.map((c) => (
          <li>
            <a href={`/organize/${c.id}`} class="block rounded-lg border border-ink/10 px-4 py-3 transition-transform active:scale-[0.99]">
              <span class="block text-sm font-medium">{(lang === "ja" && c.name_ja) || c.name_en}</span>
              <span class="font-mono text-xs tabular-nums text-ink-soft">{c.start_date}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById("upload-form") as HTMLFormElement;
  const progress = document.getElementById("read-progress")!;
  const error = document.getElementById("read-error")!;
  const pdfName = document.getElementById("pdf-name")!;
  const pdf = document.getElementById("pdf") as HTMLInputElement;

  pdf?.addEventListener("change", () => {
    if (pdf.files?.[0]) pdfName.textContent = pdf.files[0].name;
  });

  function show(el: HTMLElement) {
    el.classList.remove("hidden");
  }
  function hide(el: HTMLElement) {
    el.classList.add("hidden");
  }

  // The demo has no reader behind it: the upload simulates a read run,
  // fails once to show the error state, and then points at a stored program.
  let failedOnce = false;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!pdf.files?.[0]) return;
    hide(error);
    show(progress);
    window.setTimeout(() => {
      hide(progress);
      if (!failedOnce) {
        failedOnce = true;
        show(error);
      } else {
        window.location.href = "/organize/jadm32";
      }
    }, 2500);
  });

  document.getElementById("retry")?.addEventListener("click", () => {
    hide(error);
    show(progress);
    window.setTimeout(() => {
      hide(progress);
      window.location.href = "/organize/jadm32";
    }, 1500);
  });
</script>
