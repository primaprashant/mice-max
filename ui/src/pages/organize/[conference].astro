---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import ChatPanel from "../../components/live/ChatPanel.astro";
import DayGrid from "../../components/DayGrid.astro";
import DayTabs from "../../components/DayTabs.astro";
import PlanCard from "../../components/PlanCard.astro";
import OpsBadge from "../../components/OpsBadge.astro";
import {
  conferenceById,
  mainVenue,
  sessionsForConference,
  windowsForConference,
  experiencesForConference,
  experienceById,
  experienceCopy,
  experienceTravel,
  windowStats,
  headlines,
  allTags,
  offeredExperienceIds,
} from "../../data";
import { fitsWindow } from "../../data/fit";
import { getLang } from "../../data/attendee";
import { t } from "../../i18n";
import PlanFilters from "../../components/PlanFilters.astro";
import { suggestionCardsForDay, filterTagsForCards } from "../../data/suggestions";
import type { Tag, Window as FreeWindow } from "../../data/types";

const tagCatalog: Tag[] = allTags();
const { conference } = Astro.params;
const conf = conferenceById(conference ?? "");
if (!conf) return Astro.redirect("/organize");

const lang = getLang(Astro.cookies);
const confName = (lang === "ja" && conf.name_ja) || conf.name_en;

const sessions = sessionsForConference(conf.id);
const windows = windowsForConference(conf.id);
const exps = experiencesForConference(conf.id);
const stats = windowStats(conf.id);
const hs = headlines(conf.id);
const headlineByWindow = new Map<string, string>();
for (const h of hs) headlineByWindow.set(h.window_id, h.experience_id);

const days: string[] = [];
for (let t = Date.parse(conf.start_date + "T00:00:00Z"); t <= Date.parse(conf.end_date + "T00:00:00Z"); t += 86400000) {
  days.push(new Date(t).toISOString().slice(0, 10));
}
const sessionsByDay = new Map<string, typeof sessions>();
for (const s of sessions) {
  if (!sessionsByDay.has(s.day)) sessionsByDay.set(s.day, []);
  sessionsByDay.get(s.day)!.push(s);
}

// Suggestions per window: headlines first, then by shown count, all filtered
// by the shared fits rule. Cap at 6 per window: the organizer sees more than
// the attendee's 4 before approving or removing.
type Suggestion = {
  experience: NonNullable<ReturnType<typeof experienceById>>;
  copy: NonNullable<ReturnType<typeof experienceCopy>>;
  shown: number;
  joined: number;
};

const suggestionsByWindow = new Map<string, Suggestion[]>();
for (const w of windows) {
  const fits = exps
    .filter((e) => e.kind !== "extra_night")
    .map((e) => ({ e, travel: experienceTravel(e.id, conf.main_venue_place_id) }))
    .filter(({ e, travel }) => fitsWindow(e, w, travel?.minutes, conf))
    .sort((a, b) => (stats.get(b.e.id)?.shown ?? 0) - (stats.get(a.e.id)?.shown ?? 0))
    .slice(0, 6);
  const headlineId = headlineByWindow.get(w.id);
  const ordered = headlineId
    ? [{ e: experienceById(headlineId)!, travel: undefined }, ...fits.filter((f) => f.e.id !== headlineId)]
    : fits;
  const list: Suggestion[] = [];
  for (const { e } of ordered) {
    const copy = experienceCopy(e.id, lang);
    if (copy) list.push({ experience: e, copy, shown: stats.get(e.id)?.shown ?? 0, joined: stats.get(e.id)?.joined ?? 0 });
  }
  suggestionsByWindow.set(w.id, list);
}

// Extra-night offers: in the organizer's control like any other plan.
// They live in the window they run in (the day that hosts the extra
// night's plans), shown with the same stats and Remove button.
const extraNightByDay = new Map<string, { experience: NonNullable<ReturnType<typeof experienceById>>; copy: NonNullable<ReturnType<typeof experienceCopy>>; win: FreeWindow; shown: number; joined: number }[]>();
{
  const extraIds = offeredExperienceIds(conf.id, "extra_night");
  const extraWins = windows.filter((w) => w.kind === "extra_night");
  for (const id of extraIds) {
    const e = experienceById(id);
    const copy = experienceCopy(id, lang);
    if (!e || !copy) continue;
    const win = extraWins.find((w) => fitsWindow(e, w, experienceTravel(e.id, conf.main_venue_place_id)?.minutes, conf)) ?? extraWins[0];
    if (!win) continue;
    const list = extraNightByDay.get(win.day) ?? [];
    list.push({ experience: e, copy, win, shown: stats.get(id)?.shown ?? 0, joined: stats.get(id)?.joined ?? 0 });
    extraNightByDay.set(win.day, list);
  }
}

// Session details for the client-side modal, keyed by session id.
const sessionDetails = Object.fromEntries(
  sessions.map((s) => [
    s.id,
    {
      title: (lang === "ja" ? s.title_ja : s.title_en) ?? s.id,
      time: `${s.day.slice(5).replace("-", "/")} ${s.start_time}–${s.end_time}`,
      type: t(lang, `sessionType.${s.type}`),
      track: s.track,
      room: s.room,
      fee: s.fee_jpy != null && s.fee_jpy > 0 ? t(lang, "common.priceFrom", { price: `¥${s.fee_jpy.toLocaleString("ja-JP")}` }) : null,
    },
  ]),
);

// Default tab: today when the visit falls inside the conference dates, else
// Day 1. Same rule as the attendee calendar.
const today = new Intl.DateTimeFormat("en-CA", { dateStyle: "short" }).format(new Date());
const activeDay = days.includes(today) ? today : days[0];

// The venue name and address for the day header.
const venue = mainVenue(conf.main_venue_place_id);

// Experience id to card title, for the DayGrid titles prop.
const expTitles = Object.fromEntries(exps.map((e) => [e.id, experienceCopy(e.id, lang)?.card_title ?? e.id]));

const shareUrl = `${Astro.url.origin}/c/${conf.id}`;
---

<Base title={`${confName} (MiceMax)`}>
  <Header />
  <main class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <a href="/organize" class="text-sm text-ink-soft hover:underline">← {t(lang, "organizer.title")}</a>
        <h1 class="mt-2 max-w-[70ch] text-2xl font-semibold tracking-tight">{confName}</h1>
        <p class="mt-1 font-mono text-xs tabular-nums text-ink-soft">
          {conf.start_date} – {conf.end_date}
          <span class="ml-2">{sessions.length} {t(lang, "organizer.sessions")}</span>
        </p>
      </div>
    </div>

    {sessions.some((s) => s.basis === "moved_from_last") && (
      <p class="mt-3 inline-block rounded-md bg-theme-soft px-3 py-1.5 text-xs text-theme-strong">
        {t(lang, "organizer.movedFromLast")}
      </p>
    )}

    <div class="mt-3">
      <OpsBadge lang={lang} conference={conf.id} text={t(lang, "ops.badges.organizer")} />
    </div>

    <section class="mt-10">
      <DayTabs lang={lang} days={days} activeDay={activeDay}>
        {days.map((day) => {
          const daySessions = sessionsByDay.get(day) ?? [];
          const dayWindows = windows.filter((w) => w.day === day);
          const allDay = [...daySessions, ...dayWindows];
          const dayStart = allDay.length ? allDay.reduce((min, e) => (e.start_time < min ? e.start_time : min), allDay[0].start_time) : "";
          const dayEnd = allDay.length ? allDay.reduce((max, e) => (e.end_time > max ? e.end_time : max), allDay[0].end_time) : "";
          return (
          <div data-day-panel={day} class:list={["mt-6", day === activeDay ? "" : "hidden"]}>
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              {venue && (
                <p class="text-xs text-ink-soft">
                  {(lang === "ja" ? venue.name_ja : venue.name_en)}{venue.address ? ` · ${venue.address}` : ""}
                </p>
              )}
              {dayStart && (
                <p class="font-mono text-xs tabular-nums text-ink-soft">
                  {dayStart}–{dayEnd}
                </p>
              )}
            </div>
            <div class="overflow-x-auto">
              <DayGrid
                lang={lang}
                day={day}
                sessions={daySessions}
                titles={expTitles}
                today={today}
                showPlans={false}
              />
            </div>
            <p class="mt-2 text-[11px] text-ink-soft md:hidden" data-scroll-hint>
              {t(lang, "calendar.scrollHint")}
            </p>
          <plan-filters class="mt-6 grid grid-cols-1 gap-3 border-t border-ink/10 pt-4 md:grid-cols-3 lg:grid-cols-4" data-plan-filters-top>
            <h3 class="text-sm font-semibold text-ink-soft md:col-span-full">
              {t(lang, "organizer.suggestionsTitle")}
            </h3>
            {(() => {
              const cards = suggestionCardsForDay(dayWindows, suggestionsByWindow);
              const filterTags = filterTagsForCards(cards, tagCatalog);
              return (
                <>
                  <PlanFilters lang={lang} tags={filterTags} />
                  <p class="hidden text-xs text-ink-soft md:col-span-full" data-filter-empty role="status">
                    {t(lang, "calendar.noPlansMatch")}
                  </p>
                  {cards.map(({ experience, copy, win, shown, joined, tags }) => (
                    <PlanCard
                      lang={lang}
                      variant="suggest"
                      as="div"
                      title={copy.card_title}
                      hook={copy.hook}
                      experience={experience}
                      tags={tags}
                      offered={[win.day.slice(5).replace("-", "/") + " " + win.start_time + "–" + win.end_time]}
                      durationMin={experience.duration_min}
                      stats={{ shown: shown ?? 0, joined: joined ?? 0 }}
                      removable={true}
                      href={`/c/${conf.id}/e/${experience.id}`}
                      suggestId={experience.id}
                      suggestWindow={win.id}
                      tagIds={tags.map((tg) => tg.id).join(" ")}
                    />
                  ))}
                  {(extraNightByDay.get(day) ?? []).map(({ experience, copy, win, shown, joined }) => (
                    <PlanCard
                      lang={lang}
                      variant="suggest"
                      as="div"
                      title={copy.card_title}
                      hook={copy.hook}
                      experience={experience}
                      tags={[]}
                      offered={[win.day.slice(5).replace("-", "/") + " " + win.start_time + "–" + win.end_time]}
                      durationMin={experience.duration_min}
                      stats={{ shown: shown ?? 0, joined: joined ?? 0 }}
                      removable={true}
                      href={`/c/${conf.id}/e/${experience.id}`}
                      suggestId={experience.id}
                      suggestWindow={win.id}
                      tagIds=""
                    />
                  ))}
                </>
              );
            })()}
          </plan-filters>
          </div>
        );
        })}
      </DayTabs>
    </section>

    <section class="mt-12">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.share")}</h2>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.link")}</p>
          <p class="mt-1 break-all font-mono text-xs">{shareUrl}</p>
        </div>
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.qr")}</p>
          <div class="mt-2 flex h-32 w-32 items-center justify-center rounded-lg bg-paper">
            <img
              src={`https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(shareUrl)}`}
              alt={`QR code linking to the attendee page for ${confName}`}
              width="120"
              height="120"
            />
          </div>
        </div>
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.email")}</p>
          <textarea readonly class="mt-1 h-24 w-full rounded-md border border-ink/10 bg-paper p-2 font-mono text-[11px]">
{t(lang, "organizer.emailText", { name: confName, url: shareUrl })}</textarea
          >
        </div>
      </div>
    </section>
    <ChatPanel conferenceId={conf.id} lang={lang} mode="organizer" />
  </main>
  <session-modal
    data-sessions-json={JSON.stringify(sessionDetails)}
    data-close-label={t(lang, "common.dismiss")}
    data-hint-label={t(lang, "common.clickAnywhereToDismiss")}
  />
</Base>

<script>
  import "../../scripts/day-tabs";
  import "../../scripts/organizer-approve";
  import "../../scripts/session-modal";
  import "../../scripts/block-z";
  import "../../scripts/plan-filters";
</script>
