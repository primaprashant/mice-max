---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import PlanCard from "../../components/PlanCard.astro";
import {
  conferenceById,
  sessionsForConference,
  windowsForConference,
  experiencesForConference,
  experienceById,
  experienceCopy,
  experienceTravel,
  windowStats,
  headlines,
} from "../../data";
import { fitsWindow } from "../../data/fit";
import { getLang } from "../../data/attendee";
import { t } from "../../i18n";

const { conference } = Astro.params;
const conf = conferenceById(conference ?? "");
if (!conf) return Astro.redirect("/organize");

const lang = getLang(Astro.cookies);
const confName = (lang === "ja" && conf.name_ja) || conf.name_en;

const sessions = sessionsForConference(conf.id);
const windows = windowsForConference(conf.id);
const exps = experiencesForConference(conf.id);
const stats = windowStats(conf.id);
const hs = headlines(conf.id);
const headlineByWindow = new Map<string, string>();
for (const h of hs) headlineByWindow.set(h.window_id, h.experience_id);

const days: string[] = [];
for (let t = Date.parse(conf.start_date + "T00:00:00Z"); t <= Date.parse(conf.end_date + "T00:00:00Z"); t += 86400000) {
  days.push(new Date(t).toISOString().slice(0, 10));
}
const sessionsByDay = new Map<string, typeof sessions>();
for (const s of sessions) {
  if (!sessionsByDay.has(s.day)) sessionsByDay.set(s.day, []);
  sessionsByDay.get(s.day)!.push(s);
}

type Suggestion = {
  experience: NonNullable<ReturnType<typeof experienceById>>;
  copy: NonNullable<ReturnType<typeof experienceCopy>>;
  shown: number;
  joined: number;
};

const suggestionsByWindow = new Map<string, Suggestion[]>();
for (const w of windows) {
  const fits = exps
    .filter((e) => e.kind !== "extra_night")
    .map((e) => ({ e, travel: experienceTravel(e.id, conf.main_venue_place_id) }))
    .filter(({ e, travel }) => fitsWindow(e, w, travel?.minutes, conf))
    .sort((a, b) => (stats.get(b.e.id)?.shown ?? 0) - (stats.get(a.e.id)?.shown ?? 0))
    .slice(0, 6);
  const headlineId = headlineByWindow.get(w.id);
  const ordered = headlineId
    ? [{ e: experienceById(headlineId)!, travel: undefined }, ...fits.filter((f) => f.e.id !== headlineId)]
    : fits;
  const list: Suggestion[] = [];
  for (const { e } of ordered) {
    const copy = experienceCopy(e.id, lang);
    if (copy) list.push({ experience: e, copy, shown: stats.get(e.id)?.shown ?? 0, joined: stats.get(e.id)?.joined ?? 0 });
  }
  suggestionsByWindow.set(w.id, list);
}

const shareUrl = `${Astro.url.origin}/c/${conf.id}`;
---

<Base title={`${confName} (MiceMax)`}>
  <Header />
  <main class="mx-auto max-w-7xl px-6 py-8">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <a href="/organize" class="text-sm text-ink-soft hover:underline">← {t(lang, "organizer.title")}</a>
        <h1 class="mt-2 max-w-[70ch] text-2xl font-semibold tracking-tight">{confName}</h1>
        <p class="mt-1 font-mono text-xs tabular-nums text-ink-soft">
          {conf.start_date} – {conf.end_date}
          <span class="ml-2">{sessions.length} {t(lang, "organizer.sessions")}</span>
        </p>
      </div>
    </div>

    {sessions.some((s) => s.basis === "moved_from_last") && (
      <p class="mt-3 inline-block rounded-md bg-theme-soft px-3 py-1.5 text-xs text-theme-strong">
        {t(lang, "organizer.movedFromLast")}
      </p>
    )}

    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.program")}</h2>

      {days.map((day) => (
        <div class="mt-6">
          <h3 class="font-mono text-sm font-semibold tabular-nums text-ink-soft">{day}</h3>
          <div class="mt-2 flex flex-col gap-2">
            {(sessionsByDay.get(day) ?? []).map((s) => (
              <PlanCard
                lang={lang}
                variant="row"
                time={{ start: s.start_time, end: s.end_time }}
                title={(lang === "ja" ? s.title_ja : s.title_en) ?? s.id}
              />
            ))}
            {windows
              .filter((w) => w.day === day)
              .map((w) => (
                <organizer-window class="block" data-window={w.id}>
                  <div class="rounded-lg border border-dashed border-ink/25 px-3 py-2">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="font-mono text-xs tabular-nums text-ink-soft">{w.start_time}–{w.end_time}</span>
                      <span class="text-xs font-medium uppercase tracking-wide text-ink-soft">{t(lang, `windowKind.${w.kind}`)}</span>
                    </div>
                    <p class="mt-1 text-sm font-medium">{lang === "ja" ? w.name_ja : w.name_en}</p>
                    {w.overlaps_program && w.overlap_note && (
                      <p class="mt-1 max-w-[65ch] text-xs text-ink-soft">{w.overlap_note}</p>
                    )}
                    <ul class="mt-3 flex flex-col gap-2">
                      {(suggestionsByWindow.get(w.id) ?? []).map(({ experience, copy, shown, joined }) => (
                        <li
                          class="suggestion flex items-center justify-between gap-3 rounded-md bg-banana-soft border border-banana px-3 py-2"
                          data-exp={experience.id}
                        >
                          <div class="min-w-0">
                            <p class="truncate text-sm font-medium">{copy.card_title}</p>
                            <p class="text-[11px] text-ink-soft">
                              <span class="font-mono tabular-nums">{shown}</span> {t(lang, "organizer.shown")}
                              <span class="font-mono tabular-nums">{joined}</span> {t(lang, "organizer.joined")}
                            </p>
                          </div>
                          <div class="flex flex-shrink-0 gap-2">
                            <button data-action="remove" class="rounded-md border border-ink/15 px-2.5 py-1 text-xs font-medium transition-transform active:scale-[0.97]">
                              {t(lang, "organizer.remove")}
                            </button>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </organizer-window>
              ))}
          </div>
        </div>
      ))}
    </section>

    <section class="mt-12">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{t(lang, "organizer.share")}</h2>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.link")}</p>
          <p class="mt-1 break-all font-mono text-xs">{shareUrl}</p>
        </div>
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.qr")}</p>
          <div class="mt-2 flex h-32 w-32 items-center justify-center rounded-lg bg-paper">
            <img
              src={`https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(shareUrl)}`}
              alt={`QR code linking to the attendee page for ${confName}`}
              width="120"
              height="120"
            />
          </div>
        </div>
        <div class="rounded-xl border border-ink/10 p-4">
          <p class="text-xs text-ink-soft">{t(lang, "organizer.email")}</p>
          <textarea readonly class="mt-1 h-24 w-full rounded-md border border-ink/10 bg-paper p-2 font-mono text-[11px]">
{t(lang, "organizer.emailText", { name: confName, url: shareUrl })}</textarea
          >
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import "../../scripts/organizer-approve";
</script>
