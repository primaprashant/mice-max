---
/** One conference card list for every view: attendee home, organizer
 * stored-conference list and the ops conference links. Props decide the
 * link target, the demo badge and what shows under the name. */
import { t, type Lang } from "../i18n";
import type { Conference } from "../data/types";

interface Props {
  lang: Lang;
  /** Exposed on the rendered `<ul>` so scripts can find the card list. */
  "data-conf-list"?: boolean;
  /** Wrapper class, for spacing on the page around the list. */
  class?: string;
  conferences: Conference[];
  /** Where a card links to; the id is appended. */
  href: (id: string) => string;
  showDemoMark?: boolean;
  /** Show the human date range (attendee) or the raw ISO date (organizer). */
  dateStyle: "range" | "iso";
  /** Card columns on md+ screens. One column when a side panel (the
   * attendee calendar) shares the row. */
  columns?: 1 | 2;
}

const {
  lang,
  conferences,
  href,
  showDemoMark = false,
  dateStyle,
  columns = dateStyle === "range" ? 2 : 1,
  class: className,
  "data-conf-list": confListAttr,
} = Astro.props;

const DEMO_IDS = ["jadm32", "icep2027"];
const isDemo = (c: Conference) => DEMO_IDS.includes(c.id);

const RANGE_OPTS: Intl.DateTimeFormatOptions = { day: "numeric", month: "short", timeZone: "UTC" };

function dateLabel(c: Conference): string {
  if (dateStyle === "iso") return c.start_date;
  const start = new Date(c.start_date + "T00:00:00Z").toLocaleDateString(lang === "ja" ? "ja-JP" : "en-GB", RANGE_OPTS);
  if (c.end_date === c.start_date) return start;
  const end = new Date(c.end_date + "T00:00:00Z").toLocaleDateString(lang === "ja" ? "ja-JP" : "en-GB", RANGE_OPTS);
  return `${start} - ${end}`;
}
---

<ul
  class:list={[
    "grid gap-3",
    className,
    columns === 2 ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1",
  ]}
  data-conf-list={confListAttr ? "" : undefined}
>
  {
    conferences.map((c) => (
      <li data-conf-start={c.start_date} data-conf-end={c.end_date} data-conf-demo={showDemoMark && isDemo(c) ? "true" : undefined}>
        <a
          href={href(c.id)}
          data-conf-link={c.id}
          data-sfx-card
          class="flex min-h-11 items-baseline justify-between gap-4 rounded-lg border border-ink/10 bg-paper p-4 transition-colors hover:border-ink/25"
        >
          <span class="min-w-0">
            <span class="flex items-baseline gap-2">
              <span class="truncate text-sm font-medium">{(lang === "ja" && c.name_ja) || c.name_en}</span>
              {showDemoMark && isDemo(c) && (
                <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-theme">
                  {t(lang, "home.demoMark")}
                </span>
              )}
            </span>
            {c.field && <span class="mt-1 block truncate text-xs text-ink-soft">{c.field}</span>}
          </span>
          <span class="shrink-0 whitespace-nowrap font-mono text-xs tabular-nums text-ink-soft">{dateLabel(c)}</span>
        </a>
      </li>
    ))
  }
</ul>
