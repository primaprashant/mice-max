---
/** The tag filter chip row above the plan cards, shared by the attendee
 * calendar and the organizer view. Chips come from the union of the day's
 * cards' tags, most used first, capped at 8, plus the All reset chip. */
import { t, type Lang } from "../i18n";
import type { Tag } from "../data/types";

interface Props {
  lang?: Lang;
  /** Tags to offer as chips, most used first. */
  tags: Tag[];
}

const { lang = "en", tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="mb-1 flex flex-wrap gap-1.5 md:col-span-full" data-plan-filters>
      <button
        type="button"
        data-plan-filter-all
        data-sfx-chip
        aria-pressed="true"
        class="flex items-center gap-1 rounded-full border border-ink/25 bg-paper min-h-11 px-2.5 py-1 text-xs text-ink-soft transition-colors hover:bg-ink/5 aria-pressed:border-theme aria-pressed:bg-theme-soft aria-pressed:text-theme-strong"
      >
        <i class="ph ph-x text-[12px]" aria-hidden="true"></i>
        {t(lang, "common.all")}
      </button>
      {tags.map((tg) => (
        <button
          type="button"
          data-plan-filter={tg.id}
          data-sfx-chip
          aria-pressed="false"
          class="flex items-center gap-1 rounded-full border border-ink/25 bg-paper min-h-11 px-2.5 py-1 text-xs text-ink-soft transition-colors hover:bg-ink/5 aria-pressed:border-theme aria-pressed:bg-theme-soft aria-pressed:text-theme-strong"
        >
          <i class={`ph ph-${tg.icon} text-[12px]`} aria-hidden="true"></i>
          {lang === "ja" ? tg.label_ja : tg.label_en}
        </button>
      ))}
    </div>
  )
}
