---
/** The photo band shared by the four top-level pages: wordmark, title,
 * the role tabs styled like the calendar's day tabs, and a hint line that
 * describes the active tab. Tabs are plain links, so no script runs here.
 * The page picks the photo (random per request, like login) and passes
 * the slug in, so its footer credit names the same image.
 * `compact` (used by /ops) drops the photo, title and hint: one dark row
 * with the wordmark, tabs and language toggle. */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  active: "attendee" | "organizer" | "city" | "ops";
  title?: string;
  /** The page picks the photo so the footer credit names the same image. */
  photoSlug?: string;
  compact?: boolean;
}

const { lang, active, title, photoSlug, compact = false } = Astro.props;

const TABS = [
  { id: "attendee", icon: "ph-users", href: "/home", labelKey: "login.roleAttendee" },
  { id: "organizer", icon: "ph-user-gear", href: "/organize", labelKey: "login.roleOrganizer" },
  { id: "city", icon: "ph-buildings", href: "/city", labelKey: "login.roleCity" },
  { id: "ops", icon: "ph-graph", href: "/ops", labelKey: "home.tabOps" },
] as const;

/* Active tab and idle tabs invert on radius too: the selected tab is the
   one solid paper pill (rounded-full, half the tab height); idle tabs
   are barely rounded tinted glass, so they sit into the photo more than
   they stand out. Both steps stay AA against their fill. */
const ACTIVE_PILL = "bg-paper text-ink rounded-full";
const IDLE_PILL = "text-paper rounded-sm ring-1 ring-paper/60";

/* The photo scrim picks its color from the active view, so each view
   reads as its own space: ink for attendees, green for organizers,
   maroon for cities, violet for operations. */
const SCRIMS: Record<string, string> = {
  attendee: "var(--color-view-attendee)",
  organizer: "var(--color-view-organizer)",
  city: "var(--color-view-city)",
  ops: "var(--color-view-ops)",
};
const scrimColor = SCRIMS[active] ?? SCRIMS.attendee!;
/* The active pill carries the same tint as the scrim. */
const activeColor = scrimColor;
---

{compact ? (
<header class="border-b border-white/10 bg-[#05070d]">
  <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-3">
    <a href="/home" class="text-xs font-semibold uppercase tracking-widest text-paper">
      {t(lang, "app.name")}
    </a>
    <nav class="order-last grid w-full grid-flow-col auto-cols-fr gap-1 sm:order-none sm:w-auto sm:flex-1">
      {TABS.map((tab) => (
        <a
          href={tab.href}
          aria-current={tab.id === active ? "page" : "false"}
          class={`${tab.id === active ? ACTIVE_PILL : IDLE_PILL} truncate px-1.5 py-1.5 text-center text-xs font-medium transition-colors sm:px-3 sm:text-sm`}
          style={tab.id === active ? undefined : `background: color-mix(in oklab, ${activeColor} 30%, transparent)`}
        >
          <i class={`ph ${tab.icon} mr-1.5 hidden align-[-0.125em] sm:inline`} aria-hidden="true" />
          {t(lang, tab.labelKey)}
        </a>
      ))}
    </nav>
    <lang-toggle class="ml-auto inline-flex rounded-md border border-white/20 bg-paper/20 p-0.5 text-xs sm:ml-0">
      <button data-lang="en" class="rounded px-2 py-1 font-medium text-paper">EN</button>
      <button data-lang="ja" class="rounded px-2 py-1 font-medium text-paper">JA</button>
    </lang-toggle>
  </div>
</header>
) : (
<header class="relative flex min-h-[50dvh] flex-col">
  <img
    src={`/images/login/${photoSlug}.webp`}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0"
    style={`background: linear-gradient(to right, color-mix(in oklab, ${scrimColor} 80%, transparent), color-mix(in oklab, ${scrimColor} 40%, transparent), color-mix(in oklab, ${scrimColor} 10%, transparent))`}
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 flex w-full justify-end px-6 pt-4">
    <div class="flex items-center gap-2">
      <lang-toggle class="inline-flex rounded-md border border-white/20 bg-paper/20 p-0.5 text-xs backdrop-blur">
        <button data-lang="en" class="rounded px-2 py-1 font-medium text-paper">EN</button>
        <button data-lang="ja" class="rounded px-2 py-1 font-medium text-paper">JA</button>
      </lang-toggle>
      <sfx-toggle
        aria-pressed="true"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/20 bg-paper/20 text-sm text-paper backdrop-blur transition-colors hover:bg-paper/30"
      >
        <i class="ph ph-speaker-high" aria-hidden="true"></i>
        <span class="sr-only">Toggle UI sounds</span>
      </sfx-toggle>
    </div>
  </div>
  <div class="relative z-10 mx-auto mt-auto flex w-full max-w-7xl flex-col px-6 pb-10 pt-5">
    <a href="/home" class="text-xs font-semibold uppercase tracking-widest text-paper">
      {t(lang, "app.name")}
    </a>
    {title && (
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-paper [text-shadow:0_1px_3px_rgba(0,0,0,0.5)]">
        {title}
      </h1>
    )}

    <div class="mt-6 grid grid-flow-col auto-cols-fr gap-1">
      {
        TABS.map((tab) => (
          <a
            href={tab.href}
            data-sfx-tab
            aria-current={tab.id === active ? "page" : "false"}
            class={`${tab.id === active ? ACTIVE_PILL : IDLE_PILL} px-3 py-1.5 text-center text-sm font-medium transition-colors`}
            style={tab.id === active ? undefined : `background: color-mix(in oklab, ${activeColor} 30%, transparent)`}
          >
            <i class={`ph ${tab.icon} mr-1.5 align-[-0.125em]`} aria-hidden="true" />
            {t(lang, tab.labelKey)}
          </a>
        ))
      }
    </div>
    <p class="mt-2 text-sm text-paper/90 [text-shadow:0_1px_3px_rgba(0,0,0,0.5)]">
      {t(lang, `home.hint${active.charAt(0).toUpperCase()}${active.slice(1)}`)}
    </p>
  </div>
</header>
)}

<script>
  import "../scripts/lang-toggle";
  import "../scripts/sfx";
</script>
