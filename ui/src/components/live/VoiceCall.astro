---
/** Live booking call: a judge plays the hotel front desk; the ElevenLabs agent calls through the mic. */
import type { Lang } from "../../i18n";
import { t } from "../../i18n";
import ModeLabel from "../ModeLabel.astro";

interface Props { conferenceId: string; lang: Lang; mode?: "attendee" | "organizer" }
const { conferenceId, lang } = Astro.props;
const k = (key: string) => t(lang, `voice.${key}`);
const strings = Object.fromEntries(
  ["idle", "connecting", "listening", "speaking", "reading", "done", "error", "mic"].map((s) => [s, k(`status.${s}`)]),
);
const labels = { agent: k("agent"), staff: k("staff"), confirmed: k("confirmed"), notConfirmed: k("notConfirmed"), role: k("role") };
---

<section
  data-voice-call
  data-conference={conferenceId}
  data-lang={lang}
  data-strings={JSON.stringify(strings)}
  data-labels={JSON.stringify(labels)}
  hidden
  class="mt-6 rounded-xl border border-ink/10 bg-paper px-5 py-4"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="flex items-center gap-2 text-sm font-semibold">
      <i class="ph ph-phone-call text-base" aria-hidden="true"></i>
      {k("title")}
    </h2>
    <div class="flex items-center gap-2">
      <span class="rounded border border-ink/20 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-soft">{k("simulated")}</span>
      <ModeLabel lang={lang} mode="live" />
    </div>
  </div>
  <p class="mt-2 max-w-[75ch] text-sm text-ink-soft">{k("intro")}</p>
  <div class="mt-3 rounded-lg border border-ink/10 px-4 py-3">
    <p class="font-mono text-[10px] uppercase tracking-wider text-ink-soft">{k("roleLabel")}</p>
    <p data-role class="mt-1 text-sm"></p>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button data-start type="button" class="min-h-11 rounded-lg bg-ink px-4 text-sm font-semibold text-paper hover:opacity-90">
      {k("start")}
    </button>
    <button data-end type="button" hidden class="min-h-11 rounded-lg border border-ink/20 px-4 text-sm font-semibold hover:bg-ink/5">
      {k("end")}
    </button>
    <p data-status role="status" aria-live="polite" class="text-sm text-ink-soft">{strings.idle}</p>
  </div>

  <div data-transcript-box hidden class="mt-4">
    <p class="font-mono text-[10px] uppercase tracking-wider text-ink-soft">{k("transcript")}</p>
    <ol data-transcript class="mt-2 space-y-2"></ol>
  </div>

  <div data-result hidden class="mt-4 rounded-lg border border-ink/10 px-4 py-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">{k("result")}</h3>
      <span data-r-confirmed class="font-mono text-[10px] uppercase tracking-wider"></span>
    </div>
    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
      <dt class="text-ink-soft">{k("date")}</dt><dd data-r-date class="font-mono tabular-nums"></dd>
      <dt class="text-ink-soft">{k("time")}</dt><dd data-r-time class="font-mono tabular-nums"></dd>
      <dt class="text-ink-soft">{k("party")}</dt><dd data-r-party class="font-mono tabular-nums"></dd>
      <dt class="text-ink-soft">{k("notes")}</dt><dd data-r-notes class="break-words"></dd>
    </dl>
  </div>
</section>

<script>
  import "../../scripts/voice-call";
</script>
