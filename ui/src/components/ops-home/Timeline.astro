---
/** "One conference, end to end": the JADM32 beats from data/ops-home.ts.
 * The page script fills the line on scroll and fades each beat in. */
import { t, type Lang } from "../../i18n";
import { TIMELINE, agentById, deptColor } from "../../data/ops-home";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ja = lang === "ja";
---

<section id="oh-timeline" class="relative mx-auto w-full max-w-7xl scroll-mt-8 px-6 py-28 lg:py-36">
  <p class="font-mono text-xs uppercase tracking-[0.24em] text-sky-300/90">{t(lang, "opsHome.timeline.kicker")}</p>
  <h2 class="mt-4 text-4xl font-semibold tracking-tight text-white lg:text-5xl">{t(lang, "opsHome.timeline.title")}</h2>
  <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">{t(lang, "opsHome.timeline.intro")}</p>

  <ol class="relative mt-16 max-w-4xl flex flex-col gap-6" data-oh-timeline>
    <div class="absolute bottom-3 left-[7px] top-3 w-px bg-white/10 lg:left-[167px]" aria-hidden="true">
      <div class="oh-line-fill absolute inset-x-0 top-0 h-full origin-top" data-oh-fill></div>
    </div>
    {TIMELINE.map((b) => {
      const agents = b.agents.map((id) => agentById(id)).filter((a) => a !== undefined);
      const color = agents[0] ? deptColor(agents[0].dept) : "#38bdf8";
      return (
        <li class="oh-beat relative grid gap-2 pl-9 lg:grid-cols-[140px_1fr] lg:gap-14 lg:pl-0" style={`--c:${color}`} data-oh-beat>
          <span class="oh-node absolute left-0 top-[22px] size-[15px] rounded-full lg:left-[160px]" aria-hidden="true"></span>
          <p class="pt-5 font-mono text-sm tabular-nums text-slate-400 lg:text-right">{ja ? b.time_ja : b.time_en}</p>
          <a href={b.link} class="oh-glass group block rounded-2xl p-5 transition-colors hover:border-white/20 lg:ml-6 lg:p-6">
            <div class="flex flex-wrap gap-2">
              {agents.map((a) => (
                <span class="rounded-md px-2 py-0.5 font-mono text-xs" style={`color:${deptColor(a.dept)};background:color-mix(in srgb, ${deptColor(a.dept)} 14%, transparent)`}>
                  {a.id}
                </span>
              ))}
            </div>
            <p class="mt-3 text-lg leading-relaxed text-slate-100">{ja ? b.text_ja : b.text_en}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-slate-400 transition-colors group-hover:text-white">
              {t(lang, "opsHome.timeline.open")}
              <i class="ph ph-arrow-right transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</section>
