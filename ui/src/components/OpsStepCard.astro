---
/** One expandable step card on the Ops timeline. Closed: time, agent, tool,
 * title. Open: the JA/EN summary, model and tokens, the output JSON. The
 * details toggle is the native <details> element. The JSON ships in a hidden
 * script tag and the <pre> fills on first open (scripts/ops-output.ts), so
 * collapsed cards cost almost nothing. */
import { t, type Lang } from "../i18n";
import type { AgentStep } from "../data/types";
import ModeLabel from "./ModeLabel.astro";

interface Props {
  lang?: Lang;
  step: AgentStep;
  /** Already truncated by the page via truncateOutput(). */
  output?: unknown;
  /** Flags shared by every row of the phase; matching rows hide their chip. */
  showDefaults?: { simulated?: boolean; mode?: "replay" | null };
}

const { lang = "en", step, output, showDefaults = {} } = Astro.props;
const title = lang === "ja" ? step.title_ja : step.title_en;
const summary = lang === "ja" ? step.summary_ja : step.summary_en;
const hhmm = step.ts.slice(11, 16);
const day = step.ts.slice(0, 10);
const shown = output !== undefined ? output : step.output;
const hasOutput = shown != null && Object.keys(shown as object).length > 0;
// Compact JSON for the script tag; "</" cannot appear as < escapes.
const outputJson = JSON.stringify(shown).replace(/</g, "\\u003c");

const TOOL_ICON: Record<string, string> = {
  llm: "chats",
  jev: "scales",
  graph: "graph",
  voice: "phone-call",
  video: "video-camera",
  search: "magnifying-glass",
  rules: "list-checks",
};
---

<ops-card class="group block" data-step={step.id}>
  <details class="ops-details" data-ops-details>
    <summary class="flex cursor-pointer list-none items-center gap-3 rounded-lg border border-ink/10 bg-paper px-4 py-3 transition-colors hover:border-ink/25">
      <span class="font-mono text-[11px] tabular-nums text-ink-soft">
        <span class="hidden sm:inline">{day} </span>{hhmm}
      </span>
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-theme-soft">
        {step.tool && <i class={`ph ph-${TOOL_ICON[step.tool] ?? "circle"} text-[13px] text-theme`} aria-hidden="true"></i>}
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-medium">{title}</span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-ink-soft">
          <span class="mr-2">{step.agent}</span>
          {step.tool && <span>{t(lang, `ops.tool.${step.tool}`)}</span>}
          {step.model && <span class="hidden md:inline ml-2">{step.model.split("/").pop()}</span>}
        </span>
      </span>
      {step.simulated && !showDefaults.simulated && (
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-current/30 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide">
          <i class="ph ph-flask text-[12px]" aria-hidden="true"></i>
          {t(lang, "common.simulated")}
        </span>
      )}
      {step.handed_to_human && (
        <span class="hidden shrink-0 items-center gap-1 rounded-full border border-current/30 px-2 py-0.5 text-[11px] font-medium sm:inline-flex">
          <i class="ph ph-hand-heart text-[12px]" aria-hidden="true"></i>
          {t(lang, "ops.handedToHuman")}
        </span>
      )}
      {!(showDefaults.mode && step.mode === showDefaults.mode) && <ModeLabel lang={lang} mode={step.mode} />}
      <i class="ops-caret ph ph-caret-down text-[13px] text-ink-soft transition-transform" aria-hidden="true"></i>
    </summary>
    <div class="mt-1 ml-6 rounded-lg border border-ink/10 bg-ink/[0.03] px-4 py-3">
      <p class="max-w-[75ch] break-words whitespace-pre-line text-sm leading-relaxed">{summary}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[10px] tabular-nums text-ink-soft">
        {step.model && <span>{t(lang, "ops.model")}: {step.model}</span>}
        {step.ms != null && <span>{t(lang, "ops.ms", { ms: step.ms })}</span>}
        {step.tokens_in != null && step.tokens_out != null && (
          <span>{t(lang, "ops.tokens", { tin: step.tokens_in, tout: step.tokens_out })}</span>
        )}
        {step.confidence != null && <span>confidence {step.confidence.toFixed(2)}</span>}
      </div>
      {hasOutput && (
        <div class="mt-3">
          <p class="font-mono text-[10px] uppercase tracking-wider text-ink-soft">{t(lang, "ops.output")}</p>
          <script is:inline type="application/json" data-ops-output set:html={outputJson} />
          <pre class="hidden mt-1 max-h-64 overflow-auto rounded-md bg-ink p-3 font-mono text-[10px] leading-relaxed text-paper" data-ops-pre><code></code></pre>
        </div>
      )}
    </div>
  </details>
</ops-card>

<style>
  details[open] .ops-caret {
    transform: rotate(180deg);
  }
</style>
