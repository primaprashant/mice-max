---
/** The two live entry points from the control room: read a new conference, sales agent. */
import { t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const links = [
  { href: "/ops/run", label: "control.runCta", note: "control.runNote", icon: "ph-globe", strong: true },
  { href: "/ops/sales", label: "control.salesCta", note: "control.salesNote", icon: "ph-handshake", strong: false },
];
---

<div class="mt-6 grid gap-3 sm:grid-cols-2">
  {links.map((l) => (
    <a
      href={l.href}
      class:list={[
        "group flex min-h-11 items-center gap-4 rounded-xl px-5 py-4 transition-colors",
        l.strong ? "bg-theme text-paper hover:bg-theme-strong" : "border border-ink/15 hover:border-ink/30",
      ]}
    >
      <i class:list={["ph text-2xl", l.icon]} aria-hidden="true"></i>
      <span class="min-w-0 flex-1">
        <span class="flex items-center gap-2 font-semibold">
          {t(lang, l.label)}
          <span
            class:list={[
              "rounded px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider",
              l.strong ? "bg-paper text-theme-strong" : "bg-ink text-paper",
            ]}
          >{t(lang, "ops.live")}</span>
        </span>
        <span class:list={["block text-xs", l.strong ? "text-paper/80" : "text-ink-soft"]}>{t(lang, l.note)}</span>
      </span>
      <i class="ph ph-arrow-right transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
    </a>
  ))}
</div>
