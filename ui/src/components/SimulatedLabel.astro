---
import { t, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
  class?: string;
}

const { lang = "en", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-full border border-current/30 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide",
    className,
  ]}
>
  <i class="ph ph-flask text-[12px]" aria-hidden="true"></i>
  {t(lang, "common.simulated")}
</span>
