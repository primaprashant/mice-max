---
/** Live or Replay label for an agent step row (D34: labels can't drift). */
import { t, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
  mode: "live" | "replay";
}

const { lang = "en", mode } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider",
    mode === "live" ? "bg-ink text-paper" : "border border-ink/20 text-ink-soft",
  ]}
>
  {mode === "live" ? t(lang, "ops.live") : t(lang, "ops.replay")}
</span>
